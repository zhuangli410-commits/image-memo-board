{
  "name": "image-clipboard",
  "version": "1.0.0",
  "description": "浮动图片剪贴板",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64",
    "build:all": "electron-builder --mac --arm64 && electron-builder --win --x64"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.imageclipboard.app",
    "productName": "图片剪贴板",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052"
    },
    "dmg": {
      "title": "图片剪贴板",
      "window": { "width": 540, "height": 380 }
    }
  }
}
