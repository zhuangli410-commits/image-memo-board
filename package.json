{
  "name": "image-clipboard",
  "version": "0.1.19",
  "description": "常驻桌面的图片中转站与多模态 DDL 备忘录",
  "author": "Image Memo Board",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/renderer.js",
    "test": "node --test tests/*.test.js",
    "build:mac": "electron-builder --mac --arm64 --dir",
    "build:win": "electron-builder --win --x64",
    "build:all": "electron-builder --mac --arm64 && electron-builder --win --x64"
  },
  "dependencies": {
    "chokidar": "^3.6.0"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.imagememoboard.desktop.v1",
    "productName": "ImageMemoBoard",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "native/bin",
        "to": "native",
        "filter": ["**/*"]
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "extendInfo": {
        "CFBundleDisplayName": "图片备忘站",
        "NSMicrophoneUsageDescription": "用于录制语音备忘",
        "NSSpeechRecognitionUsageDescription": "用于把语音备忘转写为文字"
      },
      "target": [
        { "target": "dir", "arch": ["arm64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "installerLanguages": ["zh_CN"],
      "language": "2052"
    },
    "dmg": {
      "title": "图片剪贴板",
      "window": { "width": 540, "height": 380 }
    }
  }
}
